Screen {
    background: #101418;
    color: #d7e0e8;
}

Header {
    background: #151c22;
    color: #8be9fd;
}

Footer {
    background: #151c22;
}

#app-body {
    height: 1fr;
}

#sidebar {
    width: 27;
    min-width: 22;
    padding: 2 2;
    background: #151c22;
    border-right: solid #28343d;
}

#brand {
    height: 4;
    margin-bottom: 2;
}

#sidebar Button {
    width: 100%;
    margin-bottom: 1;
}

#sidebar Button.active {
    background: #123d4c;
    color: #c8f3ff;
    text-style: bold;
    border: round #8be9fd;
}

#sidebar-note {
    margin-top: 2;
}

#main-column {
    width: 1fr;
    padding: 1 3;
}

#toolbar {
    height: 5;
    layout: horizontal;
}

#view-title {
    width: 1fr;
    padding: 1 2;
    margin-right: 1;
    color: #b8f1ff;
    text-style: bold;
    background: #19232b;
    border: round #40505c;
}

#search {
    width: 20;
    border: round #40505c;
}

CommitComposerScreen {
    align: center middle;
}

#composer-dialog {
    width: 80%;
    min-width: 50;
    max-width: 100;
    height: auto;
    max-height: 90%;
    padding: 1 2;
    background: #151c22;
    border: heavy #8be9fd;
}

#composer-title {
    height: 3;
    color: #b8f1ff;
    text-style: bold;
}

#composer-context {
    height: auto;
    max-height: 12;
    overflow-y: auto;
    padding: 1 2;
    margin: 1 0;
    background: #101418;
    border: round #40505c;
}

#commit-body {
    height: 10;
    margin: 1 0;
    border: round #40505c;
}

#composer-actions {
    height: 3;
}

#submit-commit {
    width: 24;
    margin-right: 1;
}

#cancel-commit {
    width: 20;
    margin-right: 1;
}

#composer-status {
    height: auto;
    margin-top: 1;
}

CommitDetailScreen {
    align: center middle;
}

#NotificationDetailScreen {
    align: center middle;
}

#notification-detail-dialog {
    width: 75%;
    min-width: 45;
    max-width: 90;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: #151c22;
    border: heavy #8be9fd;
}

#notification-detail-title {
    height: 3;
    color: #b8f1ff;
    text-style: bold;
}

#notification-detail-content {
    height: auto;
    max-height: 60%;
    overflow-y: auto;
    padding: 1 2;
    background: #101418;
    border: round #40505c;
}

#notification-detail-help {
    height: auto;
    margin-top: 1;
    color: #91a0aa;
}

#commit-detail-dialog {
    width: 85%;
    min-width: 50;
    max-width: 110;
    height: 85%;
    min-height: 14;
    max-height: 95%;
    padding: 1 2;
    background: #151c22;
    border: heavy #8be9fd;
}

#commit-detail-title {
    height: 3;
    color: #b8f1ff;
    text-style: bold;
}

#thread-history-pane {
    height: 15;
    min-height: 5;
    max-height: 15;
    overflow-y: auto;
    padding: 1 2;
    margin-bottom: 1;
    background: #101418;
    border: round #40505c;
}

#thread-context {
    height: auto;
}

#replies-title {
    height: 3;
    color: #b8f1ff;
    text-style: bold;
}

#replies-status {
    height: auto;
    color: #91a0aa;
}

#notifications-note {
    height: auto;
    margin-bottom: 1;
    color: #91a0aa;
}

#commit-replies {
    height: 1fr;
    min-height: 5;
    border: round #28343d;
}

#detail-help {
    height: auto;
    margin-top: 1;
    color: #91a0aa;
}

#views {
    height: 1fr;
}

#following-list, #latest-list, #trending-list, #notifications-list {
    background: transparent;
    scrollbar-size: 1 1;
    border: round #28343d;
}

.commit-card {
    padding: 1 2;
}

.notification-card {
    padding: 1 2;
}

ListItem {
    margin-bottom: 1;
    background: #151c22;
    border: round #28343d;
}

ListItem:hover {
    background: #1b252d;
    border: round #8be9fd;
}

ListView > ListItem.-highlight {
    color: #effaff;
    background: #123d4c;
    border: round #8be9fd;
    text-style: bold;
}

#following-view, #latest-view, #trending-view, #notifications-view, #profile {
    padding: 2;
}

#profile-card {
    padding: 2;
    margin-bottom: 1;
    background: #151c22;
    border: round #28343d;
}

.log-status {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    color: #ff8a8a;
}

#sign-in, #logout {
    width: 24;
}

#auth-callback {
    width: 1fr;
    margin: 1 0;
}

#complete-sign-in {
    width: 24;
}
