Screen {
    background: #101418;
    color: #d7e0e8;
}

Header {
    background: #151c22;
    color: #8be9fd;
}

Footer {
    background: #151c22;
}

#app-body {
    height: 1fr;
}

#sidebar {
    width: 27;
    min-width: 22;
    padding: 2 2;
    background: #151c22;
    border-right: solid #28343d;
}

#brand {
    height: 4;
    margin-bottom: 2;
}

#sidebar Button {
    width: 100%;
    margin-bottom: 1;
}

#sidebar Button.active {
    background: #123d4c;
    color: #c8f3ff;
    text-style: bold;
    border: round #8be9fd;
}

#sidebar-note {
    margin-top: 2;
}

#main-column {
    width: 1fr;
    padding: 1 3;
}

#toolbar {
    height: 5;
    layout: horizontal;
}

#view-title {
    width: 1fr;
    padding: 1 2;
    margin-right: 1;
    color: #b8f1ff;
    text-style: bold;
    background: #19232b;
    border: round #40505c;
}

#search {
    width: 20;
    border: round #40505c;
}

CommitComposerScreen {
    align: center middle;
}

#composer-dialog {
    width: 80%;
    min-width: 50;
    max-width: 100;
    height: auto;
    max-height: 90%;
    overflow-y: auto;
    padding: 1 2;
    background: #151c22;
    border: heavy #8be9fd;
}

#composer-dialog.image-view-active,
#commit-detail-dialog.image-view-active {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: 100%;
    min-height: 0;
    max-height: 100%;
    padding: 0;
}

#composer-dialog.image-view-active #composer-title,
#composer-dialog.image-view-active #composer-context,
#composer-dialog.image-view-active #composer-status,
#composer-dialog.image-view-active #composer-actions,
#commit-detail-dialog.image-view-active #commit-detail-title {
    display: none;
}

#composer-title,
#commit-detail-title {
    height: 3;
    color: #b8f1ff;
    text-style: bold;
}

#composer-context {
    height: auto;
    max-height: 9;
    overflow-y: auto;
    padding: 1 2;
    margin: 1 0;
    background: #101418;
    border: round #40505c;
}

#commit-body {
    height: 7;
    margin: 1 0;
    border: round #40505c;
}

#composer-mode,
#composer-form,
#composer-image-view {
    height: 1fr;
}

#composer-image-view {
    align: center middle;
}

#composer-images-label {
    height: 1;
    color: #91a0aa;
}

#composer-images {
    height: auto;
    color: #91a0aa;
}

#composer-actions {
    height: 3;
    margin-top: 1;
}

#find-images,
#remove-image,
#submit-commit {
    width: 1fr;
    min-width: 8;
    margin-right: 1;
}

#cancel-commit {
    width: 1fr;
    min-width: 8;
    margin-right: 1;
}

#composer-status {
    height: auto;
    margin-top: 1;
    margin-bottom: 1;
}

#composer-help,
#detail-help {
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: #91a0aa;
    text-align: center;
}

#composer-dialog.image-view-active #composer-help,
#commit-detail-dialog.image-view-active #detail-help {
    margin-top: 0;
    padding: 0 1;
    border-top: solid #40505c;
}

CommitDetailScreen {
    align: center middle;
    width: 100%;
    height: 100%;
}

#NotificationDetailScreen {
    align: center middle;
}

#notification-detail-dialog {
    width: 75%;
    min-width: 45;
    max-width: 90;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    background: #151c22;
    border: heavy #8be9fd;
}

#notification-detail-title {
    height: 3;
    color: #b8f1ff;
    text-style: bold;
}

#notification-detail-content {
    height: auto;
    max-height: 60%;
    overflow-y: auto;
    padding: 1 2;
    background: #101418;
    border: round #40505c;
}

#notification-detail-help {
    height: auto;
    margin-top: 1;
    color: #91a0aa;
}

#commit-detail-dialog {
    width: 95%;
    min-width: 50;
    max-width: 95%;
    height: 95%;
    min-height: 14;
    max-height: 95%;
    padding: 1 2;
    background: #151c22;
    border: heavy #8be9fd;
}

#thread-columns {
    height: 1fr;
}

#thread-mode {
    height: 1fr;
}

#thread-image-view,
#composer-image-view {
    height: 1fr;
    align: center middle;
}

#thread-image-content {
    position: relative;
    width: 1fr;
    height: 1fr;
    align: center middle;
}

#thread-image-map {
    position: absolute;
    offset: 0 0;
    layer: overlay;
    width: 19;
    height: 12;
    padding: 1;
    background: #101418;
    border: round #40505c;
}

#thread-image-caption {
    width: 1fr;
    height: 2;
    color: #b8f1ff;
    text-style: bold;
    text-align: center;
}

#thread-image-minimap-title {
    height: 1;
    color: #91a0aa;
    text-style: bold;
}

#thread-image-minimap {
    width: 15;
    height: 7;
}

#thread-history-pane {
    width: 42%;
    height: 1fr;
    min-height: 5;
    overflow-y: auto;
    padding: 1 2;
    margin-right: 1;
    background: #101418;
    border: round #40505c;
}

#thread-replies-pane {
    width: 1fr;
    height: 1fr;
}

#thread-context {
    height: auto;
}

#current-commit-title {
    height: 1;
    color: #b8f1ff;
    text-style: bold;
}

#current-commit-pane {
    height: auto;
    min-height: 9;
    max-height: 12;
    overflow-y: auto;
    padding: 0 1;
    margin-bottom: 1;
    background: #101418;
    border: round #40505c;
}

#current-commit {
    height: auto;
}

.commit-image-preview {
    height: auto;
    margin-top: 1;
}

.terminal-image {
    width: 32;
    height: 9;
}

.detail-image-preview .terminal-image {
    width: 1fr;
    height: 1fr;
}

.detail-image-preview {
    width: 1fr;
    height: 1fr;
    margin-top: 0;
    padding: 1;
    align: center middle;
}

.commit-image-status {
    height: auto;
    color: #91a0aa;
}

#replies-title {
    height: 3;
    color: #b8f1ff;
    text-style: bold;
}

#replies-status {
    height: auto;
    color: #91a0aa;
}

#notifications-note {
    height: auto;
    margin-bottom: 1;
    color: #91a0aa;
}

#commit-replies {
    height: 1fr;
    min-height: 5;
    border: round #28343d;
}

#detail-help {
    height: auto;
    margin-top: 1;
    color: #91a0aa;
}

#views {
    height: 1fr;
}

#following-list, #latest-list, #trending-list, #notifications-list {
    background: transparent;
    scrollbar-size: 1 1;
    border: round #28343d;
}

.commit-card {
    padding: 1 2;
}

.notification-card {
    padding: 1 2;
}

ListItem {
    margin-bottom: 1;
    background: #151c22;
    border: round #28343d;
}

ListItem:hover {
    background: #1b252d;
    border: round #8be9fd;
}

ListView > ListItem.-highlight {
    color: #effaff;
    background: #123d4c;
    border: round #8be9fd;
    text-style: bold;
}

#following-view, #latest-view, #trending-view, #notifications-view, #profile {
    padding: 2;
}

#profile-card {
    padding: 2;
    margin-bottom: 1;
    background: #151c22;
    border: round #28343d;
}

.log-status {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    color: #ff8a8a;
}

#sign-in, #logout {
    width: 24;
}

#auth-callback {
    width: 1fr;
    margin: 1 0;
}

#complete-sign-in {
    width: 24;
}
